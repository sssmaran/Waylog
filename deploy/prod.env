HAPPY_SAMPLE_RATE_PCT=5
EVENT_LOG_SYNC=true
GRAPH_RETENTION=24h

# Auth — scoped API keys (comma-separated for rotation)
WAYLOG_WRITE_KEY=changeme-write
# WAYLOG_READ_KEY=changeme-read
# WAYLOG_AGENT_KEY=changeme-agent

# Dashboard auth: off | basic:<user>:<pass> | key:<secret>
# DASHBOARD_AUTH=basic:admin:changeme
# DASHBOARD_SESSION_SECRET=generate-a-random-secret
