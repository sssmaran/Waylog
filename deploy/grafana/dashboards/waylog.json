{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "links": [],
  "panels": [
    {
      "title": "",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "id": 100
    },
    {
      "title": "Ingest Rate",
      "description": "Events accepted per second (1m rate)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 10 }
            ]
          },
          "unit": "ops",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "rate(waylog_events_accepted_total[1m])",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "title": "Graph Nodes",
      "description": "Total nodes in the in-memory graph",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "purple", "value": 10000 }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "waylog_graph_nodes",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "title": "Graph Edges",
      "description": "Total edges in the in-memory graph",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "purple", "value": 50000 }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "waylog_graph_edges",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "title": "Status",
      "description": "Server readiness (1 = ready, 0 = not ready)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NOT READY", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "READY", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "waylog_ready",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 6
    },

    {
      "title": "Ingest Pipeline",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "id": 101
    },
    {
      "title": "Event Throughput",
      "description": "Events accepted per second over time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "drawStyle": "line",
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "rate(waylog_events_accepted_total[1m])",
          "legendFormat": "accepted/s",
          "refId": "A"
        }
      ],
      "id": 10
    },

    {
      "title": "Latency",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "id": 102
    },
    {
      "title": "Ingest Latency (p50 / p95 / p99)",
      "description": "Full /v1/events handler latency — from request received to response sent",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "drawStyle": "line",
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(waylog_ingest_latency_seconds_bucket[1m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(waylog_ingest_latency_seconds_bucket[1m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(waylog_ingest_latency_seconds_bucket[1m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "id": 20
    },
    {
      "title": "Merge Latency (p50 / p95 / p99)",
      "description": "Time to build graph nodes/edges from event and merge into store",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "drawStyle": "line",
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(waylog_merge_latency_seconds_bucket[1m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(waylog_merge_latency_seconds_bucket[1m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(waylog_merge_latency_seconds_bucket[1m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "id": 21
    },
    {
      "title": "Ingest Latency Heatmap",
      "description": "Distribution of ingest latency across histogram buckets — reveals bimodal patterns",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "calculate": false,
        "yAxis": { "unit": "s" },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64
        },
        "cellGap": 1,
        "tooltip": { "show": true, "yHistogram": true },
        "showValue": "never"
      },
      "targets": [
        {
          "expr": "sum(increase(waylog_ingest_latency_seconds_bucket[1m])) by (le)",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "id": 22
    },

    {
      "title": "Graph Store",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "id": 103
    },
    {
      "title": "Graph Size Over Time",
      "description": "Node and edge counts — shows graph growth and retention pruning",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "drawStyle": "line",
            "gradientMode": "opacity",
            "showPoints": "never",
            "axisPlacement": "auto"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "nodes" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "edges" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "waylog_graph_nodes",
          "legendFormat": "nodes",
          "refId": "A"
        },
        {
          "expr": "waylog_graph_edges",
          "legendFormat": "edges",
          "refId": "B"
        }
      ],
      "id": 30
    },
    {
      "title": "Edge-to-Node Ratio",
      "description": "Higher ratio = denser graph (more connections per entity). Typical: 2-5x",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "super-light-purple" },
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "drawStyle": "line",
            "gradientMode": "scheme",
            "showPoints": "never"
          },
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "waylog_graph_edges / waylog_graph_nodes",
          "legendFormat": "edges/node",
          "refId": "A"
        }
      ],
      "id": 31
    },
    {
      "title": "Retention Prune Cycles",
      "description": "Graph retention prune cycles per minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "light-orange" },
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
            "drawStyle": "bars",
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "increase(waylog_graph_pruned_total[1m])",
          "legendFormat": "prune cycles/min",
          "refId": "A"
        }
      ],
      "id": 32
    },

    {
      "title": "Durability & Persistence",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false,
      "id": 104
    },
    {
      "title": "Event Log Write Failures",
      "description": "WAL write failures — any non-zero value means events are being lost",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 33 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "dark-red" },
          "custom": {
            "fillOpacity": 40,
            "lineWidth": 2,
            "drawStyle": "bars",
            "showPoints": "never"
          },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "increase(waylog_eventlog_write_failures_total[1m])",
          "legendFormat": "WAL failures/min",
          "refId": "A"
        }
      ],
      "id": 40
    },
    {
      "title": "Snapshot Health",
      "description": "Time since last successful vs last failed snapshot save",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 33 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "drawStyle": "line",
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "since last success" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "since last error" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "time() - waylog_snapshot_last_success_timestamp",
          "legendFormat": "since last success",
          "refId": "A"
        },
        {
          "expr": "time() - waylog_snapshot_last_error_timestamp > 0",
          "legendFormat": "since last error",
          "refId": "B"
        }
      ],
      "id": 41
    },
    {
      "title": "Snapshot Age",
      "description": "Seconds since last successful snapshot. Should stay under 10s (snapshot tick = 5s)",
      "type": "stat",
      "gridPos": { "h": 7, "w": 4, "x": 16, "y": 33 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "orange", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          },
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "time() - waylog_snapshot_last_success_timestamp",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 42
    },
    {
      "title": "WAL Failures Total",
      "description": "Total cumulative event log write failures",
      "type": "stat",
      "gridPos": { "h": 7, "w": 4, "x": 20, "y": 33 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "waylog_eventlog_write_failures_total",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 43
    },

    {
      "title": "System Health",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "collapsed": false,
      "id": 105
    },
    {
      "title": "Readiness & Replay",
      "description": "Server state: ready=1 means accepting traffic, replay=1 means startup replay in progress",
      "type": "state-timeline",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 41 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "replay" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "IDLE", "color": "green" } } },
                  { "type": "value", "options": { "1": { "text": "REPLAYING", "color": "yellow" } } }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 1 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showValue": "always",
        "mergeValues": true,
        "alignValue": "center",
        "rowHeight": 0.8
      },
      "targets": [
        {
          "expr": "waylog_ready",
          "legendFormat": "ready",
          "refId": "A"
        },
        {
          "expr": "waylog_replay_in_progress",
          "legendFormat": "replay",
          "refId": "B"
        }
      ],
      "id": 50
    },
    {
      "title": "Replay Lag",
      "description": "Seconds since last replayed event during startup. 0 after replay completes",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 41 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "super-light-yellow" },
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 2,
            "drawStyle": "line",
            "gradientMode": "scheme",
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["max"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "waylog_replay_lag_seconds",
          "legendFormat": "replay lag",
          "refId": "A"
        }
      ],
      "id": 51
    },
    {
      "title": "Replay Failures",
      "description": "Number of failed startup replay attempts",
      "type": "stat",
      "gridPos": { "h": 5, "w": 3, "x": 18, "y": 41 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
