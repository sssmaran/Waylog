HAPPY_SAMPLE_RATE_PCT=100
EVENT_LOG_SYNC=false
GRAPH_RETENTION=1h
GRAPH_UI=1

# Cold storage (SQLite)
SQLITE_PATH=./data/waylog.db

# Causal inference (shadow mode — observational only)
CAUSAL_ENABLED=true
CAUSAL_SHADOW_MODE=true

# Agent API key (empty = no auth required in dev)
WAYLOG_AGENT_KEY=

# Auth — all keys unset in dev (everything open)
# WAYLOG_WRITE_KEY=
# WAYLOG_READ_KEY=
# DASHBOARD_AUTH=off
